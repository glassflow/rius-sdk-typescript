{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/tests/fixtures/semconv", "!**/tests/conformance/_recording.mjs"]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noInferrableTypes": "error",
        "useNumberNamespace": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error"
      },
      "suspicious": { "noVar": "error" }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["**/src/semconv.generated.ts"],
      "formatter": { "enabled": false }
    },
    {
      "includes": [
        "**/tests/fixtures/context_sizes_*.json",
        "**/tests/fixtures/openinference_messages.json",
        "**/tests/fixtures/vercel_cases.json"
      ],
      "formatter": { "enabled": false }
    }
  ]
}
