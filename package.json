{
  "name": "@glassflow-ai/rius",
  "version": "1.6.0",
  "description": "OpenTelemetry-native agent observability: trace every LLM call, tool call and agent step, with cost per call, alerts, and Claude Code / Codex / Cursor session tracing.",
  "keywords": [
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "llm",
    "ai-agents",
    "genai",
    "instrumentation",
    "rius",
    "glassflow",
    "llm-observability",
    "agent-observability",
    "llm-cost",
    "cost-tracking",
    "monitoring"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glassflow/rius-sdk-typescript.git"
  },
  "homepage": "https://docs.glassflow.ai/rius/sdk",
  "bugs": "https://github.com/glassflow/rius-sdk-typescript/issues",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "peerDependencies": {
    "@arizeai/openinference-instrumentation-anthropic": "^0.2.7",
    "@arizeai/openinference-instrumentation-langchain": "^4.0.17",
    "@arizeai/openinference-instrumentation-openai": "^4.4.1",
    "@langchain/core": "^1.0.0 || ^0.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@arizeai/openinference-instrumentation-anthropic": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-langchain": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/otel": "^1.0.141",
    "@anthropic-ai/sdk": "^0.133.0",
    "@arizeai/openinference-instrumentation-anthropic": "0.2.7",
    "@arizeai/openinference-instrumentation-langchain": "4.1.4",
    "@arizeai/openinference-instrumentation-openai": "^4.4.1",
    "@biomejs/biome": "^2.5.15",
    "@langchain/core": "^1.2.5",
    "@langchain/openai": "1.6.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^25.9.9",
    "ai": "^7.0.141",
    "openai": "^7.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
