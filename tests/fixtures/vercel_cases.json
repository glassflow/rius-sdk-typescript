        "gen_ai.operation.name": "invoke_agent",
        "rius.aggregated_usage.input_tokens": 42,
        "rius.aggregated_usage.output_tokens": 9,
        "ai.usage.outputTokenDetails.textTokens": 6
      },
      "expected": {
        "gen_ai.operation.name": "invoke_agent",
        "openinference.span.kind": "AGENT",
