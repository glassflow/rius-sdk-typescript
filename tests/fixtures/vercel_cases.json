{
  "about": "The Vercel AI SDK's ai.* dialect, case by case: each input is one ended span's attributes, each expected result what normalization leaves on it. Shared with the sink (argus-core apps/sink/internal/normalize/testdata/vercel_cases.json), which must store the same attributes from the same span; a number there is the attribute's string form, a list its JSON.",
  "cases": [
    {
      "name": "a model call's prompt messages, every part shape",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.messages": "[{\"role\":\"system\",\"content\":\"Be brief.\"},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Look:\"},{\"type\":\"file\",\"mediaType\":\"image/png\",\"data\":\"https://example.com/a.png\"},{\"type\":\"file\",\"mediaType\":\"audio/wav\",\"data\":\"UklGRg==\"},{\"type\":\"file\",\"data\":{\"type\":\"url\",\"url\":\"https://example.com/b.pdf\"}},{\"type\":\"file\",\"mediaType\":\"video/mp4\",\"data\":{\"type\":\"data\",\"data\":\"AAAA\"}},{\"type\":\"file\",\"mediaType\":\"text/plain\",\"data\":{\"type\":\"text\",\"text\":\"notes\"}},{\"type\":\"file\",\"mediaType\":\"image/png\",\"data\":{\"0\":1}},{\"type\":\"image\",\"image\":\"iVBORw0=\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"reasoning\",\"text\":\"Thinking.\"},{\"type\":\"tool-call\",\"toolName\":\"lookup\",\"input\":{\"q\":1.5}},{\"type\":\"custom-part\"}]},{\"role\":\"tool\",\"content\":[{\"type\":\"tool-result\",\"toolCallId\":\"c1\",\"output\":{\"type\":\"json\",\"value\":{\"ok\":true}}},{\"type\":\"tool-result\",\"toolCallId\":\"c2\",\"output\":{\"type\":\"error-text\",\"value\":\"boom\"}},{\"type\":\"tool-result\",\"toolCallId\":\"c3\",\"output\":{\"type\":\"execution-denied\",\"reason\":\"no\"}},{\"type\":\"tool-result\",\"toolCallId\":\"c4\",\"output\":{\"type\":\"content\",\"value\":[]}},{\"type\":\"tool-result\",\"toolCallId\":\"c5\"}]}]"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.input.messages": "[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Look:\"},{\"type\":\"uri\",\"modality\":\"image\",\"mime_type\":\"image/png\",\"uri\":\"https://example.com/a.png\"},{\"type\":\"blob\",\"modality\":\"audio\",\"mime_type\":\"audio/wav\",\"content\":\"UklGRg==\"},{\"type\":\"uri\",\"modality\":\"image\",\"mime_type\":null,\"uri\":\"https://example.com/b.pdf\"},{\"type\":\"blob\",\"modality\":\"video\",\"mime_type\":\"video/mp4\",\"content\":\"AAAA\"},{\"type\":\"blob\",\"modality\":\"image\",\"mime_type\":\"text/plain\",\"content\":\"notes\"},{\"type\":\"file\"},{\"type\":\"blob\",\"modality\":\"image\",\"mime_type\":null,\"content\":\"iVBORw0=\"}]},{\"role\":\"assistant\",\"parts\":[{\"type\":\"reasoning\",\"content\":\"Thinking.\"},{\"type\":\"tool_call\",\"id\":null,\"name\":\"lookup\",\"arguments\":{\"q\":1.5}},{\"type\":\"custom-part\"}]},{\"role\":\"tool\",\"parts\":[{\"type\":\"tool_call_response\",\"id\":\"c1\",\"response\":{\"ok\":true}},{\"type\":\"tool_call_response\",\"id\":\"c2\",\"response\":\"boom\"},{\"type\":\"tool_call_response\",\"id\":\"c3\",\"response\":{\"denied\":true,\"reason\":\"no\"}},{\"type\":\"tool_call_response\",\"id\":\"c4\",\"response\":{\"type\":\"content\",\"value\":[]}},{\"type\":\"tool_call_response\",\"id\":\"c5\"}]}]",
        "gen_ai.operation.name": "chat",
        "gen_ai.system_instructions": "[{\"type\":\"text\",\"content\":\"Be brief.\"}]",
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "a wrapper's prompt: system, a prompt list and messages",
      "input": {
        "ai.operationId": "ai.streamText",
        "ai.prompt": "{\"system\":[{\"role\":\"system\",\"content\":\"One.\"},{\"role\":\"system\",\"content\":\"Two.\"}],\"prompt\":[{\"role\":\"user\",\"content\":\"Hi\"}],\"messages\":[{\"role\":\"system\",\"content\":\"Three.\"},{\"role\":\"assistant\",\"content\":\"Hello\"}]}"
      },
      "expected": {
        "ai.operationId": "ai.streamText",
        "gen_ai.input.messages": "[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Hi\"}]},{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"Hello\"}]}]",
        "gen_ai.operation.name": "invoke_agent",
        "gen_ai.system_instructions": "[{\"type\":\"text\",\"content\":\"One.\"},{\"type\":\"text\",\"content\":\"Two.\"},{\"type\":\"text\",\"content\":\"Three.\"}]",
        "openinference.span.kind": "AGENT"
      }
    },
    {
      "name": "a wrapper's system message as one object",
      "input": {
        "ai.operationId": "ai.generateObject",
        "ai.prompt": "{\"system\":{\"role\":\"system\",\"content\":\"Only JSON.\"},\"prompt\":\"Make one\"}",
        "ai.response.object": "{\"a\":1}",
        "ai.response.finishReason": "other"
      },
      "expected": {
        "ai.operationId": "ai.generateObject",
        "gen_ai.input.messages": "[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Make one\"}]}]",
        "gen_ai.operation.name": "invoke_agent",
        "gen_ai.output.messages": "[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"{\\\"a\\\":1}\"}],\"finish_reason\":\"stop\"}]",
        "gen_ai.response.finish_reasons": [
          "other"
        ],
        "gen_ai.system_instructions": "[{\"type\":\"text\",\"content\":\"Only JSON.\"}]",
        "openinference.span.kind": "AGENT"
      }
    },
    {
      "name": "an unreadable prompt is left whole",
      "input": {
        "ai.operationId": "ai.generateText",
        "ai.prompt": "{\"prompt\":[{\"role\":\"user\",\"content\":[{\"text\":\"no type\"}]}]}"
      },
      "expected": {
        "ai.operationId": "ai.generateText",
        "ai.prompt": "{\"prompt\":[{\"role\":\"user\",\"content\":[{\"text\":\"no type\"}]}]}",
        "gen_ai.operation.name": "invoke_agent",
        "openinference.span.kind": "AGENT"
      }
    },
    {
      "name": "a prompt that is not JSON is left whole",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.messages": "[{\"role\":\"user\""
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.messages": "[{\"role\":\"user\"",
        "gen_ai.operation.name": "chat",
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "the response: reasoning, text and tool calls",
      "input": {
        "ai.operationId": "ai.streamText.doStream",
        "ai.response.reasoning": "Hmm.",
        "ai.response.text": "Calling.",
        "ai.response.toolCalls": "[{\"toolCallId\":\"c1\",\"toolName\":\"a\",\"input\":\"{\\\"x\\\":2}\"},{\"toolCallId\":\"c2\",\"toolName\":\"b\",\"input\":\"not json\"},{\"toolName\":\"c\",\"input\":{\"y\":true}}]",
        "ai.response.finishReason": "tool-calls",
        "ai.response.msToFirstChunk": 250
      },
      "expected": {
        "ai.operationId": "ai.streamText.doStream",
        "gen_ai.operation.name": "chat",
        "gen_ai.output.messages": "[{\"role\":\"assistant\",\"parts\":[{\"type\":\"reasoning\",\"content\":\"Hmm.\"},{\"type\":\"text\",\"content\":\"Calling.\"},{\"type\":\"tool_call\",\"id\":\"c1\",\"name\":\"a\",\"arguments\":{\"x\":2}},{\"type\":\"tool_call\",\"id\":\"c2\",\"name\":\"b\",\"arguments\":\"not json\"},{\"type\":\"tool_call\",\"name\":\"c\",\"arguments\":{\"y\":true}}],\"finish_reason\":\"tool_call\"}]",
        "gen_ai.request.stream": true,
        "gen_ai.response.finish_reasons": [
          "tool-calls"
        ],
        "gen_ai.response.time_to_first_chunk": 0.25,
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "a tool call whose input is the JSON null stays a string",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.response.toolCalls": "[{\"toolCallId\":\"c1\",\"toolName\":\"a\",\"input\":\"null\"}]",
        "ai.response.finishReason": "tool-calls"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.operation.name": "chat",
        "gen_ai.output.messages": "[{\"role\":\"assistant\",\"parts\":[{\"type\":\"tool_call\",\"id\":\"c1\",\"name\":\"a\",\"arguments\":\"null\"}],\"finish_reason\":\"tool_call\"}]",
        "gen_ai.response.finish_reasons": [
          "tool-calls"
        ],
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "unreadable tool calls leave the response whole",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.response.text": "Hi",
        "ai.response.toolCalls": "[1]",
        "ai.response.finishReason": "stop"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.response.text": "Hi",
        "ai.response.toolCalls": "[1]",
        "gen_ai.operation.name": "chat",
        "gen_ai.response.finish_reasons": [
          "stop"
        ],
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "a finish reason with no name of its own passes through",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.response.text": "",
        "ai.response.finishReason": "content-filter-v2"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.operation.name": "chat",
        "gen_ai.output.messages": "[{\"role\":\"assistant\",\"parts\":[],\"finish_reason\":\"content-filter-v2\"}]",
        "gen_ai.response.finish_reasons": [
          "content-filter-v2"
        ],
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "native messages win and the dialect goes",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.input.messages": "[]",
        "gen_ai.output.messages": "[]",
        "ai.prompt.messages": "[{\"role\":\"user\",\"content\":\"Hi\"}]",
        "ai.response.text": "Hello",
        "ai.response.finishReason": "stop",
        "gen_ai.response.finish_reasons": [
          "stop"
        ]
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.input.messages": "[]",
        "gen_ai.operation.name": "chat",
        "gen_ai.output.messages": "[]",
        "gen_ai.response.finish_reasons": [
          "stop"
        ],
        "openinference.span.kind": "LLM"
      }
    },
    {
      "name": "a forced tool choice keeps its object",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.toolChoice": "{\"type\":\"tool\", \"toolName\":\"get_weather\"}"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.operation.name": "chat",
        "openinference.span.kind": "LLM",
        "rius.request.tool_choice": "{\"type\":\"tool\",\"toolName\":\"get_weather\"}"
      }
    },
    {
      "name": "a tool choice mode is the mode",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.toolChoice": "{\"type\":\"required\"}"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "gen_ai.operation.name": "chat",
        "openinference.span.kind": "LLM",
        "rius.request.tool_choice": "required"
      }
    },
    {
      "name": "a tool choice that is not an object stays",
      "input": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.toolChoice": "auto"
      },
      "expected": {
        "ai.operationId": "ai.generateText.doGenerate",
        "ai.prompt.toolChoice": "auto",
        "gen_ai.operation.name": "chat",
        "openinference.span.kind": "LLM"
      }
    },
    {
